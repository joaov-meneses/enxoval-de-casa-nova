# PostgreSQL local via Docker (docker-compose.yml). Troque a senha.
POSTGRES_USER=larume
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=larume
POSTGRES_PORT=5433

# PostgreSQL connection used by the Express API.
# Com o Docker local, mantenha usuário, senha, porta e banco iguais aos de cima.
DATABASE_URL="postgresql://larume:troque-esta-senha@localhost:5433/larume"

# Optional. Defaults to 3000.
PORT=3000

# Optional. Set to true only when your PostgreSQL server requires SSL.
DATABASE_SSL=false

# Optional. In production, secure cookies are enabled by default.
# Set COOKIE_SECURE=false only when deploying behind plain HTTP.
COOKIE_SECURE=true

# Administrative access, configured only on the server (never use VITE_ prefixes).
# Set both values to enable /admin. No default administrator is created.
ADMIN_LOGIN=""
# At least 12 characters. Changing these credentials invalidates existing admin sessions.
ADMIN_PASSWORD=""

# Recuperação de senha por e-mail ("Esqueci minha senha").
# Endereço público do app, usado nos links dos e-mails (nunca é lido do cabeçalho Host da requisição).
# Em produção é obrigatório; em desenvolvimento, sem valor, usa http://localhost:PORT.
APP_URL=""
# Provedor de e-mail: Resend (https://resend.com). Precisa de um domínio verificado no Resend.
# Sem estes dois valores, em desenvolvimento o e-mail aparece no console do servidor; em produção, nada é enviado.
RESEND_API_KEY=""
# Remetente, por exemplo: Larume <nao-responda@seudominio.com.br>
MAIL_FROM=""
