# PostgreSQL local via Docker (docker-compose.yml). Troque a senha.
POSTGRES_USER=casamia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=casamia
POSTGRES_PORT=5433

# PostgreSQL connection used by the Express API.
# Com o Docker local, mantenha usuário, senha, porta e banco iguais aos de cima.
DATABASE_URL="postgresql://casamia:troque-esta-senha@localhost:5433/casamia"

# Optional. Defaults to 3000.
PORT=3000

# Optional. Set to true only when your PostgreSQL server requires SSL.
DATABASE_SSL=false

# Optional. In production, secure cookies are enabled by default.
# Set COOKIE_SECURE=false only when deploying behind plain HTTP.
COOKIE_SECURE=true

# Administrative access, configured only on the server (never use VITE_ prefixes).
# Set both values to enable /admin. No default administrator is created.
ADMIN_LOGIN=""
# At least 12 characters. Changing these credentials invalidates existing admin sessions.
ADMIN_PASSWORD=""

# Recuperação de senha por e-mail ("Esqueci minha senha").
# Endereço público do app, usado nos links dos e-mails (nunca é lido do cabeçalho Host da requisição).
# Em produção é obrigatório; em desenvolvimento, sem valor, usa http://localhost:PORT.
APP_URL=""
# Provedor de e-mail: Resend (https://resend.com). Precisa de um domínio verificado no Resend.
# Sem estes dois valores, em desenvolvimento o e-mail aparece no console do servidor; em produção, nada é enviado.
RESEND_API_KEY=""
# Remetente, por exemplo: Casa Mia <nao-responda@seudominio.com.br>
MAIL_FROM=""
# Opcional: e-mail que recebe um aviso a cada mensagem da central de ajuda (problemas e sugestões).
# As mensagens sempre ficam salvas e aparecem no painel administrativo (/admin), com ou sem este valor.
FEEDBACK_TO_EMAIL=""

# Acompanhamento de preços dos itens importados por link.
# A rotina relê os preços a cada 12 horas. Em produção fica ligada; em desenvolvimento, desligada.
# PRICE_TRACKER=on liga em qualquer ambiente e PRICE_TRACKER=off desliga. Também dá para rodar uma vez: npm run track-prices
PRICE_TRACKER=""
# Opcional. A API de itens do Mercado Livre recusa quem não se identifica (403). Com um aplicativo criado em
# https://developers.mercadolivre.com.br as leituras de anúncios passam a usar a API; sem isto, o servidor lê a
# página do anúncio, que o Mercado Livre costuma bloquear para acessos automáticos.
MERCADOLIVRE_CLIENT_ID=""
MERCADOLIVRE_CLIENT_SECRET=""

# Opcional. Lojas como Magalu, Casas Bahia, Leroy, Shopee e o próprio Mercado Livre barram qualquer acesso que não
# seja um navegador real (desafio JavaScript, captcha). Com uma chave de um desbloqueador, o servidor só recorre a
# ele quando a leitura direta falha ou volta sem preço. Sem chave, o formulário preenche só o nome pelo link.
# Provedores aceitos: zenrows (padrão) ou scraperapi. Chave em https://www.zenrows.com ou https://www.scraperapi.com
SCRAPER_API_KEY=""
SCRAPER_API_PROVIDER="zenrows"
# Teto de chamadas pagas por dia (por processo). Padrão: 200.
SCRAPER_API_DAILY_LIMIT="200"
# Ajustes extras na chamada, no formato de query string. Ex.: "premium_proxy=false" (ZenRows) ou "premium=false"
# (ScraperAPI) para gastar menos créditos, aceitando mais falhas.
SCRAPER_API_PARAMS=""

# Nino (Jev, da TypeSafe AI): sugere o ambiente de um item novo, avisa de compras repetidas, indica o próximo item
# essencial de um ambiente e ordena a lista por urgência. Sem a chave, essas ajudas somem e o app funciona como antes.
# Chave em https://console.typesafe.ai/keys (o SDK exige Node 22 ou mais novo).
TYPESAFE_API_KEY=""
# Opcional. Teto de chamadas ao Jev por dia: por processo, ou somado entre instâncias quando há REDIS_URL. Padrão: 3000.
JEV_DAILY_LIMIT="3000"
# Opcional. Tempo máximo de espera por resposta, em milissegundos. Padrão: 8000.
JEV_TIMEOUT_MS="8000"

# Catálogo mestre de itens (Fase 6): o que um enxoval descobre sobre um item vale para todos, e o Jev só é consultado
# para o que o catálogo ainda não conhece. Todos os valores abaixo são opcionais.
# Rotina do catálogo (vínculos, faixas de preço, itens vindos das listas) a cada 6 horas. Não chama o Jev.
# Em produção fica ligada; em desenvolvimento, desligada. CATALOG_WORKER=on liga e CATALOG_WORKER=off desliga.
# Também dá para rodar uma vez: npm run catalog:refresh  (com --urgency, pré-calcula as urgências por faixa de perfil
# e aí sim chama o Jev; --limit 600 limita quantos itens vão ao Jev na rodada).
CATALOG_WORKER=""
# Quanto tempo, em milissegundos, cada servidor guarda o catálogo em memória antes de reler do banco. Padrão: 60000.
CATALOG_CACHE_TTL_MS=""
# Enxovais distintos necessários para publicar uma faixa de preço ou sugerir um item das listas. Padrão: 5.
CATALOG_MIN_SAMPLES=""
# CATALOG_RESOLUTION=off desliga a cascata com o Jev para itens que o catálogo não conhece (o resto continua).
CATALOG_RESOLUTION=""

# Opcional: Redis compartilhado entre instâncias (só vale a pena com mais de uma instância na Railway). Com ele, as
# respostas do Jev e o teto diário de chamadas passam a valer para todas as instâncias, e uma instância avisa as outras
# quando o catálogo muda. Sem ele, ou com ele fora do ar, cada processo usa o próprio cache e o app segue igual.
# Local: npm run redis:up e REDIS_URL="redis://127.0.0.1:6380" (use 127.0.0.1, não localhost, no Windows).
REDIS_URL=""
# Prefixo das chaves, para dividir um Redis entre ambientes (ex.: homologação e produção). Padrão: casamia:
REDIS_KEY_PREFIX=""
# Quanto tempo, em segundos, uma resposta do Jev fica no Redis. Padrão: 86400 (1 dia).
JEV_SHARED_CACHE_TTL_S=""
