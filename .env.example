# PostgreSQL local via Docker (docker-compose.yml). Troque a senha.
POSTGRES_USER=casamia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=casamia
POSTGRES_PORT=5433

# PostgreSQL connection used by the Express API.
# Com o Docker local, mantenha usuário, senha, porta e banco iguais aos de cima.
DATABASE_URL="postgresql://casamia:troque-esta-senha@localhost:5433/casamia"

# Optional. Defaults to 3000.
PORT=3000

# PostHog: token publico do projeto (phc_...), nunca uma chave pessoal/administrativa.
# VITE_* e incorporado pelo Vite no build; configure antes de npm run build.
# Sem token, nao inicializa o SDK nem envia eventos.
VITE_POSTHOG_KEY=""
# Use https://eu.i.posthog.com para projetos na regiao EU.
VITE_POSTHOG_HOST="https://us.i.posthog.com"
# Desenvolvimento desligado por padrao; true permite validar eventos localmente.
VITE_POSTHOG_ENABLE_DEV="false"
# Web Analytics: apenas rotas sanitizadas, origens conhecidas e medidas numericas.
VITE_POSTHOG_WEB_VITALS="true"
# Campanhas permitidas, separadas por virgula. Outros valores viram "other".
VITE_POSTHOG_CAMPAIGNS="launch,bio,trial,enxoval,casa-nova"
# Opcional para builds de equipe/teste: internal ou test. Normalmente deixe vazio.
VITE_POSTHOG_TRAFFIC_TYPE=""
# Error Tracking no navegador (respeita opt-out e Do Not Track).
VITE_POSTHOG_ERROR_TRACKING="true"
# Servidor: usa o token publico acima quando POSTHOG_KEY nao e informado.
POSTHOG_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_ERROR_TRACKING="true"
POSTHOG_ENABLE_DEV="false"
# Logs do servidor via OpenTelemetry; usa o mesmo token publico phc_ do projeto.
# Ligado automaticamente em producao com token; false desliga apenas o envio remoto.
POSTHOG_LOGS="true"
# Teto por processo/minuto; ate 20% para sucessos selecionados, restante para warn/error/fatal.
POSTHOG_LOGS_MAX_PER_MINUTE="600"
# Somente build/CI. Nunca use prefixo VITE_ para a chave pessoal.
POSTHOG_UPLOAD_SOURCEMAPS="false"
POSTHOG_CLI_HOST="https://us.posthog.com"
POSTHOG_CLI_PROJECT_ID="665798"
POSTHOG_CLI_API_KEY=""
# Proxy proprio do PostHog: com VITE_POSTHOG_HOST="/ingest", informe o host da interface para os links do PostHog.
VITE_POSTHOG_UI_HOST=""
# Destino do proxy /ingest no servidor (https://eu.i.posthog.com na regiao EU). off desliga a rota.
POSTHOG_PROXY_HOST="https://us.i.posthog.com"
POSTHOG_PROXY=""
# on_reject: quem recusa o aviso de consentimento e medido sem cookies (exige o modo ligado no projeto PostHog).
VITE_POSTHOG_COOKIELESS=""

# Google Tag Manager (GA4 e Google Ads ficam dentro do conteiner). So carrega depois do consentimento.
VITE_GTM_ID=""
VITE_GTM_ENABLE_DEV="false"
# Conversao de compra enviada pelo servidor (GA4 Measurement Protocol). Nunca use prefixo VITE_.
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""

# E-mails de ciclo de vida (lembretes da mudanca e dicas): off (padrao), simulate ou send.
LIFECYCLE_MODE="off"
# Remetente do marketing, de preferencia num subdominio proprio. Sem ele, usa MAIL_FROM.
MARKETING_MAIL_FROM=""
# Segredo (whsec_...) do webhook do Resend. Cadastre <APP_URL>/api/webhooks/resend com email.delivered,
# email.clicked, email.bounced e email.complained. Sem ele a rota responde 404.
RESEND_WEBHOOK_SECRET=""
# Opcional: versao exibida em excecoes, eventos e rotinas. Sem ele, usa o commit da Railway (RAILWAY_GIT_COMMIT_SHA).
APP_VERSION=""

# Optional. Set to true only when your PostgreSQL server requires SSL.
DATABASE_SSL=false

# Optional. In production, secure cookies are enabled by default.
# Set COOKIE_SECURE=false only when deploying behind plain HTTP.
COOKIE_SECURE=true

# Administrative access, configured only on the server (never use VITE_ prefixes).
# Set both values to enable /admin. No default administrator is created.
ADMIN_LOGIN=""
# At least 12 characters. Changing these credentials invalidates existing admin sessions.
ADMIN_PASSWORD=""

# Recuperação de senha por e-mail ("Esqueci minha senha").
# Endereço público do app, usado nos links dos e-mails (nunca é lido do cabeçalho Host da requisição).
# Em produção é obrigatório; em desenvolvimento, sem valor, usa http://localhost:PORT.
APP_URL=""
# Provedor de e-mail: Resend (https://resend.com). Precisa de um domínio verificado no Resend.
# Sem estes dois valores, em desenvolvimento o e-mail aparece no console do servidor; em produção, nada é enviado.
RESEND_API_KEY=""
# Remetente, por exemplo: Casa Mia <nao-responda@seudominio.com.br>
MAIL_FROM=""
# Opcional: e-mail que recebe um aviso a cada mensagem da central de ajuda (problemas e sugestões).
# As mensagens sempre ficam salvas e aparecem no painel administrativo (/admin), com ou sem este valor.
FEEDBACK_TO_EMAIL=""
# Confirmação de e-mail no cadastro: conta nova só usa o app depois de abrir o link enviado.
# Ligada em produção e desligada fora dela; "true" ou "false" forçam o comportamento.
EMAIL_VERIFICATION_REQUIRED=""

# Acompanhamento de preços dos itens importados por link.
# A rotina relê os preços a cada 12 horas. Em produção fica ligada; em desenvolvimento, desligada.
# PRICE_TRACKER=on liga em qualquer ambiente e PRICE_TRACKER=off desliga. Também dá para rodar uma vez: npm run track-prices
PRICE_TRACKER=""
# Opcional. A API de itens do Mercado Livre recusa quem não se identifica (403). Com um aplicativo criado em
# https://developers.mercadolivre.com.br as leituras de anúncios passam a usar a API; sem isto, o servidor lê a
# página do anúncio, que o Mercado Livre costuma bloquear para acessos automáticos.
MERCADOLIVRE_CLIENT_ID=""
MERCADOLIVRE_CLIENT_SECRET=""

# Opcional. Lojas como Magalu, Casas Bahia, Leroy, Shopee e o próprio Mercado Livre barram qualquer acesso que não
# seja um navegador real (desafio JavaScript, captcha). Com uma chave de um desbloqueador, o servidor só recorre a
# ele quando a leitura direta falha ou volta sem preço. Sem chave, o formulário preenche só o nome pelo link.
# Provedores aceitos: zenrows (padrão) ou scraperapi. Chave em https://www.zenrows.com ou https://www.scraperapi.com
SCRAPER_API_KEY=""
SCRAPER_API_PROVIDER="zenrows"
# Teto de chamadas pagas por dia (por processo). Padrão: 200.
SCRAPER_API_DAILY_LIMIT="200"
# Ajustes extras na chamada, no formato de query string. Ex.: "premium_proxy=false" (ZenRows) ou "premium=false"
# (ScraperAPI) para gastar menos créditos, aceitando mais falhas.
SCRAPER_API_PARAMS=""

# Nino (Jev, da TypeSafe AI): sugere o ambiente de um item novo, avisa de compras repetidas, indica o próximo item
# essencial de um ambiente e ordena a lista por urgência. Sem a chave, essas ajudas somem e o app funciona como antes.
# Chave em https://console.typesafe.ai/keys (o SDK exige Node 22 ou mais novo).
TYPESAFE_API_KEY=""
# Opcional. Teto de chamadas ao Jev por dia: por processo, ou somado entre instâncias quando há REDIS_URL. Padrão: 3000.
JEV_DAILY_LIMIT="3000"
# Opcional. Tempo máximo de espera por resposta, em milissegundos. Padrão: 8000.
JEV_TIMEOUT_MS="8000"

# Catálogo mestre de itens (Fase 6): o que um enxoval descobre sobre um item vale para todos, e o Jev só é consultado
# para o que o catálogo ainda não conhece. Todos os valores abaixo são opcionais.
# Rotina do catálogo a cada 6 horas. O Jev valida nomes diferentes antes de agregá-los nos preços nacionais.
# Em produção fica ligada; em desenvolvimento, desligada. CATALOG_WORKER=on liga e CATALOG_WORKER=off desliga.
# Também dá para rodar uma vez: npm run catalog:refresh  (com --urgency, pré-calcula as urgências por faixa de perfil
# também usa o Jev; --limit 600 limita quantos itens recebem essa urgência na rodada).
CATALOG_WORKER=""
# Quanto tempo, em milissegundos, cada servidor guarda o catálogo em memória antes de reler do banco. Padrão: 60000.
CATALOG_CACHE_TTL_MS=""
# Enxovais distintos necessários para sugerir um item novo das listas ao catálogo. Padrão: 5; não altera os preços.
CATALOG_MIN_SAMPLES=""
# Preços nacionais dos clientes: mínimo de contas distintas; padrão 2, nunca menor que 2.
CATALOG_PRICE_MIN_CUSTOMERS=""
# Pesquisa compartilhada: segunda às 06h (São Paulo), 50 buscas/semana, até 250/mês. Ligue em um só ambiente.
CATALOG_MARKET_PRICES="off"
SERPAPI_API_KEY=""
# Base alternativa apenas para simulação local; o padrão é https://serpapi.com.
SERPAPI_BASE_URL=""
# Tempo limite por requisição; padrão 20000 ms. Sem repetição automática de pesquisas.
SERPAPI_TIMEOUT_MS=""
# CATALOG_RESOLUTION=off desliga a cascata com o Jev para itens que o catálogo não conhece (o resto continua).
CATALOG_RESOLUTION=""

# Opcional: Redis compartilhado entre instâncias (só vale a pena com mais de uma instância na Railway). Com ele, as
# respostas do Jev e o teto diário de chamadas passam a valer para todas as instâncias, e uma instância avisa as outras
# quando o catálogo muda. Sem ele, ou com ele fora do ar, cada processo usa o próprio cache e o app segue igual.
# Local: npm run redis:up e REDIS_URL="redis://127.0.0.1:6380" (use 127.0.0.1, não localhost, no Windows).
REDIS_URL=""
# Prefixo das chaves, para dividir um Redis entre ambientes (ex.: homologação e produção). Padrão: casamia:
REDIS_KEY_PREFIX=""
# Quanto tempo, em segundos, uma resposta do Jev fica no Redis. Padrão: 86400 (1 dia).
JEV_SHARED_CACHE_TTL_S=""

# Pagamentos pela Stripe (https://dashboard.stripe.com): assinatura mensal e Passe da Casa Nova (pagamento único, 12 meses).
# Sem estes valores o app segue no plano gratuito e o botão de pagar avisa que ainda não está disponível.
# Use as chaves de teste (sk_test_...) até lançar. Em produção, APP_URL também é obrigatório (links de retorno do checkout).
STRIPE_SECRET_KEY=""
# Segredo do webhook (whsec_...). Cadastre o endpoint <APP_URL>/api/billing/webhook com os eventos
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted,
# checkout.session.completed, checkout.session.async_payment_succeeded/failed, invoice.paid,
# customer.subscription.created/updated/deleted, charge.refunded, refund.created/updated/failed.
# Localmente: stripe listen --forward-to localhost:3000/api/billing/webhook (o segredo que ele imprime vale só localmente).
STRIPE_WEBHOOK_SECRET=""
# IDs dos preços (price_...): o mensal é recorrente (R$ 29,90/mês); o Passe é pagamento único (R$ 99,00).
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_PASS=""
# Pix para o Passe em BRL. Ative Pix também no Stripe Dashboard. false mantém apenas cartão.
# Mensal no cartão com trial de 48 h, conforme decisão de produto. Pix Automático indisponível para conta BR.
STRIPE_PIX_ENABLED="true"

# NFS-e direta: Emissor Público Nacional / SEFIN. Transmissão desligada até homologar.
# Eventos pagos são registrados mesmo desligada; nenhuma nota é transmitida sem habilitação.
NFSE_NACIONAL_ENABLED="false"
NFSE_NACIONAL_ENVIRONMENT="homologacao"
# Confirmar habilitação do CNPJ no CNC/RFB/Emissor Nacional com a contabilidade/SEFAZ.
NFSE_NACIONAL_ISSUER_ENABLED="false"
# A1 em PEM (certificado com cadeia; chave privada pode ser criptografada), apenas no backend.
NFSE_NACIONAL_CERT_PATH=""
NFSE_NACIONAL_KEY_PATH=""
NFSE_NACIONAL_KEY_PASSPHRASE=""
# JSON do leiaute oficial: ver docs/pagamentos-e-notas-fiscais.md. Sem tributação presumida.
NFSE_NACIONAL_TAX_CONFIG=""
NFSE_NACIONAL_REQUIRE_ADDRESS="true"
# manual | payment_confirmed | period_end. Não ativar automação sem orientação contábil.
NFSE_NACIONAL_ISSUE_ON="manual"
# payment_date | period_start | period_end
NFSE_NACIONAL_COMPETENCE="payment_date"
NFSE_NACIONAL_ACCOUNTING_REFERENCE=""
# Normalmente vazio: usa apenas URLs oficiais. Host local só com opt-in de simulação.
NFSE_NACIONAL_BASE_URL=""
NFSE_NACIONAL_ALLOW_LOCAL_SIMULATION="false"


# Logs com Pino: trace, debug, info, warn, error, fatal ou silent.
LOG_LEVEL="info"
# Vazio: pretty em desenvolvimento e JSON em produção. Aceita pretty ou json.
LOG_FORMAT=""
# Requisições acima deste tempo, em ms, recebem nível warn e slow=true.
LOG_SLOW_REQUEST_MS="1000"

# Notas, garantias e manuais dos itens (Fase 11.4). "database" guarda no Postgres, inclusive em produção com cota e backups;
# "s3" usa um bucket privado compatível com S3 (Cloudflare R2 ou S3), com download por URL assinada de 5 minutos.
DOCUMENT_STORAGE="database"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Espaço para documentos por conta (dona dos enxovais), em MB.
DOCUMENT_QUOTA_MB="500"
# Tentativas de leitura OCR por pessoa/dia. Modelo português local: nenhuma chave de IA é necessária.
RECEIPT_READ_DAILY_LIMIT="20"
SERPAPI_API_KEY= ""
CATALOG_MARKET_PRICES=off
