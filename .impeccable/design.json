    },
    {
      "name": "Cartão da landing",
      "kind": "card",
      "refersTo": "card-landing",
      "description": "Recurso ou benefício na landing.",
      "html": "<article class=\"ds-card\"><h3>Lista a dois</h3><p>Casais e moradores na mesma lista: o que um risca, o outro vê ao abrir o app.</p></article>",
      "css": ".ds-card{max-width:320px;padding:30px 26px 28px;text-align:center;background:#fbf8f4;border:1px solid #e7ded1;border-radius:24px;box-shadow:0 1px 2px #422d240d,0 10px 24px -18px #3b2a2040;transition:transform .25s cubic-bezier(.22,1,.36,1),box-shadow .25s}.ds-card:hover{transform:translateY(-3px);box-shadow:0 18px 36px -20px #3b2a2059}.ds-card h3{margin:0 0 8px;font:600 20px/1.25 'Fraunces Variable','Fraunces',ui-serif,Georgia,serif;color:#2f2a26}.ds-card p{margin:0;font:400 15px/1.6 'Nunito Variable','Nunito',ui-sans-serif,system-ui,sans-serif;color:#635b52}"
    },
    {
      "name": "Linha de item",
      "kind": "custom",
      "refersTo": "item-row",
      "description": "Item da lista com círculo de conquista; conquistado fica riscado.",
      "html": "<div class=\"ds-item\"><span class=\"ds-check\" role=\"checkbox\" aria-checked=\"true\" tabindex=\"0\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg></span><span class=\"ds-item-name\">Jogo de lençol casal</span><span class=\"ds-item-meta\">Quarto · 2 un.</span><strong>R$ 189,90</strong></div>",
      "css": ".ds-item{display:flex;align-items:center;gap:14px;padding:17px 18px;font:500 13px/1.35 'Nunito Variable','Nunito',ui-sans-serif,system-ui,sans-serif;color:#5b6e50;background:#fff;border:1px solid #e7ded1;border-radius:8px}.ds-item:hover{border-color:#d7c6ad}.ds-check{display:grid;place-items:center;width:23px;height:23px;color:#fff;background:#93a386;border:1.5px solid #93a386;border-radius:50%}.ds-check:focus-visible{outline:none;box-shadow:inset 0 0 0 2px #a34c30}.ds-item-name{flex:1;text-decoration:line-through}.ds-item-meta{font:600 12px/1.4 'Nunito Variable','Nunito',ui-sans-serif,system-ui,sans-serif;color:#6f6358}.ds-item strong{font-variant-numeric:tabular-nums;color:#5b6e50}"
    },
    {
      "name": "Progresso do cômodo",
