  "components": [
    {
      "name": "Botão principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A única ação forte da tela, na landing.",
      "html": "<a class=\"ds-btn-primary\" href=\"#\">Começar teste de 2 dias <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 22px;font:700 15px/1.25 'Nunito Variable','Nunito',ui-sans-serif,system-ui,sans-serif;color:#fff;text-decoration:none;background:var(--cm-action,#a34c30);border:1.5px solid var(--cm-action,#a34c30);border-radius:14px;box-shadow:0 2px 6px #873c2526;transition:background-color .15s,border-color .15s,transform .15s}.ds-btn-primary:hover{background:var(--cm-action-hover,#8a3f27);border-color:var(--cm-action-hover,#8a3f27)}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:none;box-shadow:inset 0 0 0 2px #fff,inset 0 0 0 4px #a34c30}"
    },
    {
      "name": "Botão de apoio",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ações secundárias: Entrar, Ver como funciona, plano não destacado.",
      "html": "<a class=\"ds-btn-secondary\" href=\"#\">Ver como funciona</a>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;min-height:44px;padding:0 22px;font:700 15px/1.25 'Nunito Variable','Nunito',ui-sans-serif,system-ui,sans-serif;color:#a34c30;text-decoration:none;background:#fff;border:1.5px solid #a34c30;border-radius:14px;transition:background-color .15s,border-color .15s,color .15s,transform .15s}.ds-btn-secondary:hover{color:#8a3f27;border-color:#8a3f27;background:#f0e8dc}.ds-btn-secondary:active{transform:scale(.98)}.ds-btn-secondary:focus-visible{outline:none;box-shadow:inset 0 0 0 2px #a34c30}"
    },
    {
      "name": "Botão do app",
      "kind": "button",
      "refersTo": "button-app",
      "description": "Botão principal dentro do app.",
      "html": "<button class=\"ds-btn-app\" type=\"button\">Adicionar item</button>",
      "css": ".ds-btn-app{display:inline-flex;align-items:center;min-height:50px;padding:13px 23px;font:600 14px/1.4 'Nunito Variable','Nunito',ui-sans-serif,system-ui,sans-serif;color:#fff;background:#a34c30;border:1px solid transparent;border-radius:7px;cursor:pointer;transition:background .2s,transform .2s,box-shadow .2s}.ds-btn-app:hover{background:#8a3f27;transform:translateY(-2px);box-shadow:0 5px 14px #432e2415}.ds-btn-app:focus-visible{outline:none;box-shadow:inset 0 0 0 2px #fff,inset 0 0 0 4px #a34c30}"
    },
    {
      "name": "Campo",
      "kind": "input",
      "refersTo": "input",
      "description": "Input do shadcn com rótulo acima.",
      "html": "<label class=\"ds-field\"><span>Nome do item</span><input class=\"ds-input\" placeholder=\"Panela de pressão\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font:600 13px/1.4 'Nunito Variable','Nunito',ui-sans-serif,system-ui,sans-serif;color:#2f2a26}.ds-input{height:36px;padding:4px 12px;font:400 14px 'Nunito Variable','Nunito',ui-sans-serif,system-ui,sans-serif;color:#2f2a26;background:transparent;border:1px solid #958571;border-radius:10px}.ds-input::placeholder{color:#6f6358}.ds-input:focus-visible{outline:none;border-color:#a34c30}"
