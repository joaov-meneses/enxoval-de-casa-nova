{
  "name": "casamia-enxoval",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:full": "npm run db:up && npm run dev",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.js",
    "start": "node dist/server.js --production",
    "db:migrate": "tsx server/migrate.ts",
    "track-prices": "tsx server/workers/track-prices.ts",
    "catalog:refresh": "tsx server/workers/catalog-refresh.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:admin-api": "node --import tsx tests/admin-api.mjs",
    "test:onboarding-db": "node --import tsx tests/onboarding-register-db.mjs",
    "test:item-status-db": "node --import tsx tests/item-status-db.mjs",
    "test:password-reset-db": "node --import tsx tests/password-reset-db.mjs",
    "test:invitations-db": "node --import tsx tests/invitations-db.mjs",
    "test:product-scraper": "node --import tsx --test tests/product-scraper.mjs",
    "test:purchase-plan": "node --import tsx --test tests/purchase-plan.mjs",
    "test:planning-db": "node --import tsx tests/planning-db.mjs",
    "test:feedback-db": "node --import tsx tests/feedback-db.mjs",
    "test:environment-name-db": "node --import tsx tests/environment-name-db.mjs",
    "test:price-tracking-db": "node --import tsx tests/price-tracking-db.mjs",
    "test:jev": "node --import tsx --test tests/jev.mjs",
    "test:ai-db": "node --import tsx tests/ai-db.mjs",
    "test:catalog": "node --import tsx --test tests/catalog.mjs",
    "test:catalog-db": "node --import tsx tests/catalog-db.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@typesafe-ai/sdk": "^0.7.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "impit": "^0.14.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.13.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "read-excel-file": "^9.3.12",
    "vite": "^6.2.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "imagetracerjs": "^1.2.6",
    "jimp": "^1.6.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
